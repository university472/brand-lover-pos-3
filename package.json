{
  "name": "brand-lover-pos",
  "version": "1.0.0",
  "description": "Brand Lover Family Store - POS & Accounts Management",
  "author": "Umar Farooq",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset-tx": "node scripts/reset-transactions.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "server": "node --import ./server/register.js server/index.js",
    "server:dev": "node --watch --import ./server/register.js server/index.js",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "web:preview": "vite preview --config web/vite.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.6"
  },
  "build": {
    "appId": "com.brandlover.pos",
    "productName": "Brand Lover POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "database",
        "to": "database",
        "filter": [
          "production-schema.sql",
          "migrations/**/*.sql"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BrandLoverPOS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Brand Lover POS"
    }
  },
  "engines": {
    "node": ">=20.6"
  }
}
